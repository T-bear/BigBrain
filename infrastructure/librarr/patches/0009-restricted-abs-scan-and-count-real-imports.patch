diff --git a/internal/organize/scan_test.go b/internal/organize/scan_test.go
new file mode 100644
index 0000000..436f4ab
--- /dev/null
+++ b/internal/organize/scan_test.go
@@ -0,0 +1,95 @@
+package organize
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/JeremiahM37/librarr/internal/config"
+	"github.com/JeremiahM37/librarr/internal/db"
+	"github.com/JeremiahM37/librarr/internal/models"
+)
+
+// Regression for the five-minute loop: an existing path can be present under
+// a different source ID. It is not a newly imported audiobook and must not
+// increment scan_import activity or trigger further work.
+func TestAudiobookScannerExistingPathNeverCountsAsNew(t *testing.T) {
+	root := t.TempDir()
+	audioDir := filepath.Join(root, "audio")
+	bookDir := filepath.Join(audioDir, "Test Author - Test Book")
+	if err := os.MkdirAll(bookDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(bookDir, "chapter.mp3"), []byte("synthetic-not-audio"), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	database, err := db.New(filepath.Join(root, "state", "librarr.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer database.Close()
+
+	existing, err := database.AddItemWithOutcome(&models.LibraryItem{
+		Title: "Test Book", FilePath: bookDir, MediaType: "audiobook",
+		Source: "torrent", SourceID: "existing-reliable-source",
+	})
+	if err != nil || !existing.Inserted {
+		t.Fatalf("seed existing item: inserted=%v err=%v", existing.Inserted, err)
+	}
+	initialEvents, err := database.CountActivity()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	scanner := NewAudiobookScanner(&config.Config{AudiobookDir: audioDir}, database, nil)
+	scanner.scan()
+	scanner.scan()
+
+	count, err := database.CountItems("audiobook")
+	if err != nil {
+		t.Fatal(err)
+	}
+	events, err := database.CountActivity()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if count != 1 || events != initialEvents {
+		t.Fatalf("duplicate path must not generate scan imports: items=%d events_before=%d events_after=%d", count, initialEvents, events)
+	}
+	if database.HasSourceID("scan-" + bookDir) {
+		t.Fatal("duplicate must keep original source identity")
+	}
+}
+
+func TestAudiobookScannerNewItemIsRecordedOnce(t *testing.T) {
+	root := t.TempDir()
+	audioDir := filepath.Join(root, "audio")
+	bookDir := filepath.Join(audioDir, "Test Author - Test Book")
+	if err := os.MkdirAll(bookDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(bookDir, "chapter.mp3"), []byte("synthetic-not-audio"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	database, err := db.New(filepath.Join(root, "state", "librarr.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer database.Close()
+
+	scanner := NewAudiobookScanner(&config.Config{AudiobookDir: audioDir}, database, nil)
+	scanner.scan()
+	scanner.scan()
+	count, err := database.CountItems("audiobook")
+	if err != nil {
+		t.Fatal(err)
+	}
+	events, err := database.CountActivity()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if count != 1 || events != 1 || !database.HasSourceID("scan-"+bookDir) {
+		t.Fatalf("one source directory must be recorded once: items=%d events=%d", count, events)
+	}
+}

+func TestAudiobookImportConflictIsDurableAndPreservesDownload(t *testing.T) {
+	root := t.TempDir()
+	incoming := filepath.Join(root, "incoming", "Author - Book")
+	if err := os.MkdirAll(incoming, 0755); err != nil {
+		t.Fatal(err)
+	}
+	payload := filepath.Join(incoming, "book.m4b")
+	if err := os.WriteFile(payload, []byte("new payload"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	libraryBook := filepath.Join(root, "audiobooks", "Author", "Book")
+	if err := os.MkdirAll(libraryBook, 0755); err != nil {
+		t.Fatal(err)
+	}
+	existing := filepath.Join(libraryBook, "existing.m4b")
+	if err := os.WriteFile(existing, []byte("existing payload"), 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	database, err := db.New(filepath.Join(root, "library.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer database.Close()
+	cfg := &config.Config{
+		FileOrgEnabled: true, AudiobookDir: filepath.Join(root, "audiobooks"),
+		QBAudiobookSavePath: filepath.Join(root, "incoming"), ImportMode: config.ImportModeCopy,
+		RemoveTorrentAfterImport: true,
+	}
+	client := &fakeTorrentClient{}
+	w := NewWatcher(cfg, database, client, nil, organize.NewOrganizer(cfg), nil, nil)
+	info := TorrentInfo{Name: "Author - Book", Hash: "hash-conflict", Progress: 1, ContentPath: incoming, SavePath: filepath.Join(root, "incoming")}
+
+	w.importTorrent(info, "audiobook")
+
+	if len(client.deletes) != 0 {
+		t.Fatalf("conflicted torrent deletion calls = %d, want 0", len(client.deletes))
+	}
+	if got, err := os.ReadFile(payload); err != nil || string(got) != "new payload" {
+		t.Fatalf("source payload changed: %q, %v", got, err)
+	}
+	if got, err := os.ReadFile(existing); err != nil || string(got) != "existing payload" {
+		t.Fatalf("existing library payload changed: %q, %v", got, err)
+	}
+	events, err := database.GetActivity(10, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(events) != 1 || events[0].EventType != "torrent_import_failed" || events[0].JobID != info.Hash {
+		t.Fatalf("failure events = %+v, want durable event for %s", events, info.Hash)
+	}
+}

@@ -0,0 +1,45 @@
+package search
+
+import (
+	"context"
+	"testing"
+
+	"github.com/JeremiahM37/librarr/internal/models"
+)
+
+type policySource struct{ name string }
+
+func (s policySource) Name() string                                                  { return s.name }
+func (s policySource) Label() string                                                 { return s.name }
+func (s policySource) Enabled() bool                                                 { return true }
+func (s policySource) Search(context.Context, string) ([]models.SearchResult, error) { return nil, nil }
+func (s policySource) SearchTab() string                                             { return "audiobook" }
+func (s policySource) DownloadType() string                                          { return "torrent" }
+
+func TestApplySourceAllowlistIsExplicitAndPreservesPreference(t *testing.T) {
+	sources := []Searcher{
+		policySource{"prowlarr_audiobooks"},
+		policySource{"audiobookbay"},
+		policySource{"future_upstream_source"},
+	}
+
+	selected, err := ApplySourceAllowlist(sources, "prowlarr_audiobooks,audiobookbay")
+	if err != nil {
+		t.Fatalf("ApplySourceAllowlist returned error: %v", err)
+	}
+	if len(selected) != 2 || selected[0].Name() != "prowlarr_audiobooks" || selected[1].Name() != "audiobookbay" {
+		t.Fatalf("unexpected selected sources: %#v", selected)
+	}
+}
+
+func TestApplySourceAllowlistFailsClosed(t *testing.T) {
+	sources := []Searcher{policySource{"prowlarr_audiobooks"}}
+	tests := []string{"", "prowlarr_audiobooks,", "prowlarr_audiobooks,prowlarr_audiobooks", "unknown"}
+	for _, configured := range tests {
+		t.Run(configured, func(t *testing.T) {
+			if _, err := ApplySourceAllowlist(sources, configured); err == nil {
+				t.Fatal("expected fail-closed allowlist error")
+			}
+		})
+	}
+}

@@ -0,0 +1,20 @@
+package api
+
+import "testing"
+
+func TestInfoHashFromMagnetIsBoundedAndNormalized(t *testing.T) {
+	want := "0123456789abcdef0123456789abcdef01234567"
+	got := infoHashFromMagnet("magnet:?xt=urn:btih:0123456789ABCDEF0123456789ABCDEF01234567&dn=Book")
+	if got != want {
+		t.Fatalf("infoHashFromMagnet = %q, want %q", got, want)
+	}
+	for _, invalid := range []string{
+		"https://example.invalid/file",
+		"magnet:?xt=urn:btih:short",
+		"magnet:?xt=urn:btih:zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz",
+	} {
+		if got := infoHashFromMagnet(invalid); got != "" {
+			t.Fatalf("infoHashFromMagnet(%q) = %q, want empty", invalid, got)
+		}
+	}
+}

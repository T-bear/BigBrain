diff --git a/internal/search/source_policy.go b/internal/search/source_policy.go
new file mode 100644
index 0000000..62b38b2
--- /dev/null
+++ b/internal/search/source_policy.go
@@ -0,0 +1,46 @@
+package search
+
+import (
+	"fmt"
+	"strings"
+)
+
+// ApplySourceAllowlist retains only explicitly approved source identifiers.
+// It preserves constructor order so an owner-managed Prowlarr source can stay
+// preferred, and rejects configuration drift rather than silently activating
+// or ignoring a source.
+func ApplySourceAllowlist(sources []Searcher, configured string) ([]Searcher, error) {
+	configured = strings.TrimSpace(configured)
+	if configured == "" {
+		return nil, fmt.Errorf("source allowlist is required")
+	}
+
+	allowed := make(map[string]struct{})
+	for _, raw := range strings.Split(configured, ",") {
+		name := strings.TrimSpace(raw)
+		if name == "" {
+			return nil, fmt.Errorf("source allowlist contains an empty identifier")
+		}
+		if _, duplicate := allowed[name]; duplicate {
+			return nil, fmt.Errorf("source allowlist contains duplicate identifier %q", name)
+		}
+		allowed[name] = struct{}{}
+	}
+
+	available := make(map[string]struct{}, len(sources))
+	selected := make([]Searcher, 0, len(allowed))
+	for _, source := range sources {
+		name := source.Name()
+		available[name] = struct{}{}
+		if _, approved := allowed[name]; approved {
+			selected = append(selected, source)
+		}
+	}
+
+	for name := range allowed {
+		if _, exists := available[name]; !exists {
+			return nil, fmt.Errorf("source allowlist references unavailable identifier %q", name)
+		}
+	}
+	return selected, nil
+}

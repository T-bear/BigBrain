+// selectionTextWithBoundaries preserves a separator between adjacent DOM
+// nodes. ABB's live search markup places "English" directly before a nested
+// "Keywords:" element; goquery.Text concatenates those as
+// "EnglishKeywords:", which made the language gate reject valid rows.
+func selectionTextWithBoundaries(selection *goquery.Selection) string {
+	parts := make([]string, 0, selection.Contents().Length())
+	selection.Contents().Each(func(_ int, node *goquery.Selection) {
+		if value := strings.TrimSpace(node.Text()); value != "" {
+			parts = append(parts, value)
+		}
+	})
+	return strings.Join(parts, " ")
+}

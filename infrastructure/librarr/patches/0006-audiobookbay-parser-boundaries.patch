 )
 
+func TestAudioBookBayCurrentSearchMarkupRetainsEnglishRows(t *testing.T) {
+	body, err := os.ReadFile("testdata/audiobookbay-current-search.html")
+	if err != nil {
+		t.Fatalf("read fixture: %v", err)
+	}
+	rt := &abbRoundTripper{body: string(body)}
+	reg, err := sourcestest.Registry()
+	if err != nil {
+		t.Fatalf("load registry: %v", err)
+	}
+	cfg := &config.Config{UserAgent: "test", Sources: reg}
+	cfg.Sources.AudioBookBay.Mirrors = []string{"fixture.invalid"}
+	a := &AudioBookBay{cfg: cfg, client: &http.Client{Transport: rt}}
+
+	results, err := a.searchDomain(context.Background(), "fixture.invalid", "fixture author")
+	if err != nil {
+		t.Fatalf("searchDomain returned error: %v", err)
+	}
+	if len(results) != 2 {
+		t.Fatalf("expected 2 English results and one rejected non-English result, got %d", len(results))
+	}
+	if results[0].Title != "A Long Journey - Example Author" || results[1].Title != "A Long Journey: Volume Two - Example Author" {
+		t.Fatalf("unexpected sanitized fixture titles: %#v", results)
+	}
+}

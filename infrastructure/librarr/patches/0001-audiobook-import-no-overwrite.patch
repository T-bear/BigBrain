+package organize
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/JeremiahM37/librarr/internal/config"
+)
+
+func audiobookOrganizer(t *testing.T, mode string) (*Organizer, string, string) {
+	t.Helper()
+	root := t.TempDir()
+	incoming := filepath.Join(root, "incoming")
+	library := filepath.Join(root, "audiobooks")
+	if err := os.MkdirAll(incoming, 0755); err != nil {
+		t.Fatal(err)
+	}
+	return NewOrganizer(&config.Config{FileOrgEnabled: true, AudiobookDir: library, ImportMode: mode}), incoming, library
+}
+
+func TestAudiobookMoveEmptyDestinationSucceeds(t *testing.T) {
+	o, incoming, _ := audiobookOrganizer(t, config.ImportModeMove)
+	src := filepath.Join(incoming, "book.m4b")
+	writeFile(t, src, []byte("new"))
+	dst, err := o.OrganizeAudiobook(src, "Book", "Author")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(src); !os.IsNotExist(err) {
+		t.Fatalf("source must be removed after successful move: %v", err)
+	}
+	assertFileContent(t, dst, "new")
+}
+
+func TestAudiobookMoveExistingBookDirectoryFailsClosed(t *testing.T) {
+	o, incoming, library := audiobookOrganizer(t, config.ImportModeMove)
+	src := filepath.Join(incoming, "book.m4b")
+	existing := filepath.Join(library, "Author", "Book", "book.m4b")
+	writeFile(t, src, []byte("new"))
+	writeFile(t, existing, []byte("existing"))
+	_, err := o.OrganizeAudiobook(src, "Book", "Author")
+	assertConflict(t, err)
+	assertFileContent(t, src, "new")
+	assertFileContent(t, existing, "existing")
+}
+
+func TestAudiobookMoveDirectoryConflictPreservesSourceTree(t *testing.T) {
+	o, incoming, library := audiobookOrganizer(t, config.ImportModeMove)
+	src := filepath.Join(incoming, "download")
+	writeFile(t, filepath.Join(src, "01.mp3"), []byte("one"))
+	writeFile(t, filepath.Join(src, "02.mp3"), []byte("two"))
+	existing := filepath.Join(library, "Author", "Book", "01.mp3")
+	writeFile(t, existing, []byte("existing"))
+	_, err := o.OrganizeAudiobook(src, "Book", "Author")
+	assertConflict(t, err)
+	assertFileContent(t, filepath.Join(src, "01.mp3"), "one")
+	assertFileContent(t, filepath.Join(src, "02.mp3"), "two")
+	assertFileContent(t, existing, "existing")
+}
+
+func TestAudiobookCopyExistingDestinationFailsWithoutTruncation(t *testing.T) {
+	dir := t.TempDir()
+	src := filepath.Join(dir, "src.m4b")
+	dst := filepath.Join(dir, "dst.m4b")

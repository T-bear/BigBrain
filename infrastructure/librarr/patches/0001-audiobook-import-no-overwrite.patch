+var errAudiobookImportConflict = errors.New("audiobook import destination conflict")
+
+func validateAudiobookPathComponent(value string) error {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return nil
+	}
+	if filepath.IsAbs(value) || value == "." || value == ".." ||
+		strings.Contains(value, "/") || strings.Contains(value, `\`) {
+		return fmt.Errorf("invalid audiobook destination component")
+	}
+	return nil
+}
+
+// reserveAudiobookDestination creates the final book directory atomically.
+// Existing or partially populated book directories are always conflicts: an
+// audiobook import never merges with or replaces existing library content.
+func reserveAudiobookDestination(root, safeAuthor, destDir string) error {
+	if err := os.MkdirAll(root, 0755); err != nil {
+		return err
+	}
+	authorDir, err := joinUnder(root, safeAuthor)
+	if err != nil {
+		return err
+	}
+	if info, statErr := os.Lstat(authorDir); statErr == nil {
+		if info.Mode()&os.ModeSymlink != 0 || !info.IsDir() {
+			return fmt.Errorf("%w: author destination is not a regular directory", errAudiobookImportConflict)
+		}
+	} else if os.IsNotExist(statErr) {
+		if mkdirErr := os.Mkdir(authorDir, 0755); mkdirErr != nil && !os.IsExist(mkdirErr) {
+			return mkdirErr
+		}
+	} else {
+		return statErr
+	}
+	if err := os.Mkdir(destDir, 0755); err != nil {
+		if os.IsExist(err) {
+			return fmt.Errorf("%w: book destination already exists", errAudiobookImportConflict)
+		}
+		return err
+	}
+	return nil
+}
+
+// placeAudiobookFile uses exclusive creation for every mode. Move mode copies
+// and syncs before deleting the source so a failed placement preserves it.
+func (o *Organizer) placeAudiobookFile(src, dst string) error {
+	switch o.importMode() {
+	case config.ImportModeHardlink:
+		if err := linkFile(src, dst); err == nil {
+			return nil
+		} else if errors.Is(err, fs.ErrExist) {
+			return fmt.Errorf("%w: file already exists", errAudiobookImportConflict)
+		}
+		return copyFileForAudiobook(src, dst)
+	case config.ImportModeCopy:
+		return copyFileForAudiobook(src, dst)
+	default:
+		if err := copyFileForAudiobook(src, dst); err != nil {
+			return err
+		}
+		if err := syncFile(dst); err != nil {
+			_ = os.Remove(dst)
+			return err
+		}
+		if err := os.Remove(src); err != nil {
+			_ = os.Remove(dst)
+			return err
+		}
+		return nil
+	}
+}
+
+func copyFileForAudiobook(src, dst string) error {
+	srcFile, err := os.Open(src)
+	if err != nil {
+		return err
+	}
+	defer srcFile.Close()
+	dstFile, err := os.OpenFile(dst, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0644)
+	if err != nil {
+		if os.IsExist(err) {
+			return fmt.Errorf("%w: file already exists", errAudiobookImportConflict)
+		}
+		return err
+	}
+	ok := false
+	defer func() {
+		_ = dstFile.Close()
+		if !ok {
+			_ = os.Remove(dst)
+		}
+	}()
+	if _, err := io.Copy(dstFile, srcFile); err != nil {
+		return err
+	}
+	if err := dstFile.Sync(); err != nil {
+		return err
+	}
+	ok = true
+	return nil
+}
+
+func (o *Organizer) placeAudiobookDirTree(srcDir, dstDir string) error {
+	type entry struct {
+		src string
+		dst string
+		dir bool
+	}
+	entries := make([]entry, 0)
+	err := filepath.WalkDir(srcDir, func(path string, d os.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if path == srcDir {
+			return nil
+		}
+		if d.Type()&os.ModeSymlink != 0 {
+			if d.IsDir() {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		rel, err := filepath.Rel(srcDir, path)
+		if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+			return fmt.Errorf("invalid audiobook source path")
+		}
+		dst := filepath.Join(dstDir, rel)
+		if _, err := joinUnder(dstDir, rel); err != nil {
+			return err
+		}
+		entries = append(entries, entry{src: path, dst: dst, dir: d.IsDir()})
+		return nil
+	})
+	if err != nil {
+		return err
+	}
+
+	createdFiles := make([]string, 0)
+	createdDirs := make([]string, 0)
+	cleanup := func() {
+		for i := len(createdFiles) - 1; i >= 0; i-- {
+			_ = os.Remove(createdFiles[i])
+		}
+		for i := len(createdDirs) - 1; i >= 0; i-- {
+			_ = os.Remove(createdDirs[i])
+		}
+	}
+	for _, item := range entries {
+		if item.dir {
+			if err := os.Mkdir(item.dst, 0755); err != nil {
+				cleanup()
+				if os.IsExist(err) {
+					return fmt.Errorf("%w: directory already exists", errAudiobookImportConflict)
+				}
+				return err
+			}
+			createdDirs = append(createdDirs, item.dst)
+			continue
+		}
+		var placeErr error
+		if o.importMode() == config.ImportModeMove {
+			// Keep the complete source tree until every destination file has
+			// been placed successfully; only then remove it as one operation.
+			placeErr = copyFileForAudiobook(item.src, item.dst)
+		} else {
+			placeErr = o.placeAudiobookFile(item.src, item.dst)
+		}
+		if placeErr != nil {
+			cleanup()
+			return placeErr
+		}
+		createdFiles = append(createdFiles, item.dst)
+	}
+	if o.importMode() == config.ImportModeMove {
+		if err := os.RemoveAll(srcDir); err != nil {
+			// Destination placement is already complete. Do not remove it if
+			// source cleanup partially failed: that could leave neither tree
+			// complete. Return the error and retain the completed destination.
+			return err
+		}
+	}
+	return nil
+}

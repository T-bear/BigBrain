+}
+
+func TestAudiobookAuthorSymlinkRejected(t *testing.T) {
+	o, incoming, library := audiobookOrganizer(t, config.ImportModeCopy)
+	src := filepath.Join(incoming, "book.m4b")
+	writeFile(t, src, []byte("new"))
+	outside := filepath.Join(filepath.Dir(library), "outside")
+	if err := os.MkdirAll(library, 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(outside, 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(library, "Author")); err != nil {
+		t.Fatal(err)
+	}
+	_, err := o.OrganizeAudiobook(src, "Book", "Author")
+	if err == nil {
+		t.Fatal("expected symlink destination rejection")
+	}
+	assertFileContent(t, src, "new")
+	if _, err := os.Stat(filepath.Join(outside, "Book")); !os.IsNotExist(err) {
+		t.Fatalf("symlink escape created outside destination: %v", err)
+	}
+}
+
+func TestAudiobookTraversalAndAbsoluteComponentsRejected(t *testing.T) {
+	o, incoming, _ := audiobookOrganizer(t, config.ImportModeCopy)
+	for _, tc := range []struct{ title, author string }{
+		{"../Book", "Author"},
+		{"Book", "../Author"},
+		{"/absolute", "Author"},
+		{"Book", "/absolute"},
+		{`..\Book`, "Author"},
+	} {
+		src := filepath.Join(incoming, "book.m4b")
+		writeFile(t, src, []byte("new"))
+		if _, err := o.OrganizeAudiobook(src, tc.title, tc.author); err == nil {
+			t.Fatalf("expected rejection for title=%q author=%q", tc.title, tc.author)
+		}
+		assertFileContent(t, src, "new")
+	}
+}
+
+func TestAudiobookSourceSymlinkRejected(t *testing.T) {
+	o, incoming, _ := audiobookOrganizer(t, config.ImportModeCopy)
+	real := filepath.Join(incoming, "real.m4b")
+	link := filepath.Join(incoming, "link.m4b")
+	writeFile(t, real, []byte("real"))
+	if err := os.Symlink(real, link); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := o.OrganizeAudiobook(link, "Book", "Author"); err == nil {
+		t.Fatal("expected source symlink rejection")
+	}
+	assertFileContent(t, real, "real")
+}
+
+func assertConflict(t *testing.T, err error) {
+	t.Helper()
+	if !errors.Is(err, errAudiobookImportConflict) {
+		t.Fatalf("error = %v, want audiobook import conflict", err)
+	}
+}
+
+func assertFileContent(t *testing.T, path, want string) {
+	t.Helper()
+	got, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read %s: %v", path, err)
+	}
+	if string(got) != want {
+		t.Fatalf("%s content = %q, want %q", path, got, want)
+	}
+}


@@ -0,0 +1,93 @@
+package organize
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+)
+
+func directFixture() []byte {
+	frame := make([]byte, 417)
+	copy(frame, []byte{0xff, 0xfb, 0x90, 0})
+	return append(frame, frame...)
+}
+func TestDirectAudioValidation(t *testing.T) {
+	b := directFixture()
+	for _, c := range []struct {
+		b      []byte
+		format string
+		good   bool
+	}{{b, "mp3", true}, {b, "m4a", false}, {b[:len(b)-1], "mp3", false}, {append([]byte("ID3"), b...), "mp3", false}, {[]byte("<html>not audio</html>"), "mp3", false}} {
+		if e := ValidateDirectAudio(bytes.NewReader(c.b), int64(len(c.b)), c.format); (e == nil) != c.good {
+			t.Fatalf("validation: %v", e)
+		}
+	}
+}
+func TestDirectPlacementExclusiveConcurrentAndPartial(t *testing.T) {
+	o, _, library := audiobookOrganizer(t, "copy")
+	os.MkdirAll(library, 0755)
+	b := directFixture()
+	sum := fmt.Sprintf("%x", sha256.Sum256(b))
+	id := "11111111111111111111111111111111"
+	var wg sync.WaitGroup
+	results := make(chan string, 8)
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			rel, ino, e := o.PlaceDirectAudio(id, "Chapter", "mp3", sum, int64(len(b)), bytes.NewReader(b))
+			if e == nil {
+				if ino == "" {
+					t.Error("missing inode")
+				}
+				results <- rel
+			}
+		}()
+	}
+	wg.Wait()
+	close(results)
+	var paths []string
+	for p := range results {
+		paths = append(paths, p)
+	}
+	if len(paths) != 1 {
+		t.Fatalf("successful placements %d", len(paths))
+	}
+	actual, e := os.ReadFile(filepath.Join(library, paths[0]))
+	if e != nil || !bytes.Equal(actual, b) {
+		t.Fatal("bytes changed")
+	}
+	if _, e = os.Stat(filepath.Join(library, "BigBrain Imports", id, ".pending")); !os.IsNotExist(e) {
+		t.Fatal("staging not cleaned")
+	}
+	id = "22222222222222222222222222222222"
+	if _, _, e = o.PlaceDirectAudio(id, "Chapter", "mp3", sum, int64(len(b)), bytes.NewReader(b[:5])); e == nil {
+		t.Fatal("accepted partial")
+	}
+	if _, _, e = o.PlaceDirectAudio(id, "Chapter", "mp3", sum, int64(len(b)), bytes.NewReader(b)); e == nil {
+		t.Fatal("reused uncertain reservation")
+	}
+}
+func TestDirectPlacementRejectsSymlinkAndBadChecksum(t *testing.T) {
+	o, _, library := audiobookOrganizer(t, "move")
+	os.MkdirAll(library, 0755)
+	other := t.TempDir()
+	os.Symlink(other, filepath.Join(library, "BigBrain Imports"))
+	b := directFixture()
+	sum := fmt.Sprintf("%x", sha256.Sum256(b))
+	if _, _, e := o.PlaceDirectAudio("11111111111111111111111111111111", "Title", "mp3", sum, int64(len(b)), bytes.NewReader(b)); e == nil {
+		t.Fatal("symlink admitted")
+	}
+	entries, _ := os.ReadDir(other)
+	if len(entries) != 0 {
+		t.Fatal("escaped root")
+	}
+	os.Remove(filepath.Join(library, "BigBrain Imports"))
+	if _, _, e := o.PlaceDirectAudio("11111111111111111111111111111111", "Title", "mp3", "bad", int64(len(b)), bytes.NewReader(b)); e == nil {
+		t.Fatal("bad checksum accepted")
+	}
+}
diff --git a/internal/organize/direct_audio_validation.go b/internal/organize/direct_audio_validation.go
new file mode 100644
index 0000000..f0fe4f3
--- /dev/null
+++ b/internal/organize/direct_audio_validation.go
@@ -0,0 +1,264 @@
+package organize
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"io"
+	"strings"
+	"unicode/utf8"
+)
+
+var errDirectAudio = errors.New("unsupported or malformed audio")
+
+const directMetadataLimit = 4 << 20
+
+// Structural admission only: payloads are never decoded, interpreted or executed.
+func ValidateDirectAudio(r io.ReaderAt, size int64, format string) error {
+	if size < 8 || size > DirectAudioLimit {
+		return errDirectAudio
+	}
+	switch format {
+	case "mp3":
+		return validateDirectMP3(r, size)
+	case "m4a":
+		return validateDirectM4A(r, size)
+	default:
+		return errDirectAudio
+	}
+}
+func readDirect(r io.ReaderAt, offset, size int64) ([]byte, error) {
+	if offset < 0 || size < 0 || size > directMetadataLimit {
+		return nil, errDirectAudio
+	}
+	b := make([]byte, int(size))
+	_, e := r.ReadAt(b, offset)
+	return b, e
+}
+func syncSafe(b []byte) (int, bool) {
+	if len(b) != 4 {
+		return 0, false
+	}
+	n := 0
+	for _, c := range b {
+		if c&128 != 0 {
+			return 0, false
+		}
+		n = n<<7 | int(c)
+	}
+	return n, true
+}
+func zeroBytes(b []byte) bool {
+	for _, c := range b {
+		if c != 0 {
+			return false
+		}
+	}
+	return true
+}
+func id3End(r io.ReaderAt, size int64) (int64, error) {
+	h, e := readDirect(r, 0, 10)
+	if e != nil {
+		return 0, errDirectAudio
+	}
+	if string(h[:3]) != "ID3" {
+		return 0, nil
+	}
+	// Common v2.2/2.3/2.4 frames. Unsupported compression, unsynchronisation and
+	// extended headers fail closed rather than trusting alternate length semantics.
+	version := h[3]
+	if version < 2 || version > 4 || h[4] != 0 || h[5] != 0 && !(version == 4 && h[5] == 16) {
+		return 0, errDirectAudio
+	}
+	n, ok := syncSafe(h[6:])
+	end := int64(10 + n)
+	if !ok || n == 0 || n > directMetadataLimit || end > size {
+		return 0, errDirectAudio
+	}
+	b, e := readDirect(r, 10, int64(n))
+	if e != nil {
+		return 0, errDirectAudio
+	}
+	frames := 0
+	for p := 0; p < len(b); {
+		if b[p] == 0 {
+			if !zeroBytes(b[p:]) || h[5]&16 != 0 {
+				return 0, errDirectAudio
+			}
+			break
+		}
+		head, idLen := 10, 4
+		if version == 2 {
+			head, idLen = 6, 3
+		}
+		if len(b)-p < head || frames >= 1024 {
+			return 0, errDirectAudio
+		}
+		for _, c := range b[p : p+idLen] {
+			if !(c >= 'A' && c <= 'Z' || c >= '0' && c <= '9') {
+				return 0, errDirectAudio
+			}
+		}
+		var length int
+		if version == 2 {
+			length = int(b[p+3])<<16 | int(b[p+4])<<8 | int(b[p+5])
+		} else {
+			length = int(binary.BigEndian.Uint32(b[p+4 : p+8]))
+			if version == 4 {
+				var valid bool
+				length, valid = syncSafe(b[p+4 : p+8])
+				if !valid {
+					return 0, errDirectAudio
+				}
+			}
+			statusMask := byte(0xe0)
+			if version == 4 {
+				statusMask = 0x70
+			}
+			if b[p+8]&^statusMask != 0 || b[p+9] != 0 {
+				return 0, errDirectAudio
+			}
+		}
+		if length <= 0 || length > len(b)-p-head {
+			return 0, errDirectAudio
+		}
+		p += head + length
+		frames++
+	}
+	if frames == 0 {
+		return 0, errDirectAudio
+	}
+	if h[5]&16 != 0 {
+		f, e := readDirect(r, end, 10)
+		if e != nil || end+10 > size || string(f[:3]) != "3DI" || !bytes.Equal(f[3:], h[3:]) {
+			return 0, errDirectAudio
+		}
+		end += 10
+	}
+	return end, nil
+}
+func validateDirectMP3(r io.ReaderAt, size int64) error {
+	pos, e := id3End(r, size)
+	if e != nil {
+		return e
+	}
+	if size-pos >= 128 {
+		b, e := readDirect(r, size-128, 3)
+		if e != nil {
+			return errDirectAudio
+		}
+		if string(b) == "TAG" {
+			size -= 128
+		}
+	}
+	size, e = apeAudioEnd(r, pos, size)
+	if e != nil {
+		return e
+	}
+	rates := [16]int{0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 0}
+	samples := [4]int{44100, 48000, 32000, 0}
+	frames := 0
+	var first uint32
+	for pos < size {
+		var b [4]byte
+		if _, e := r.ReadAt(b[:], pos); e != nil {
+			return errDirectAudio
+		}
+		h := binary.BigEndian.Uint32(b[:])
+		if h&0xfffe0000 != 0xfffa0000 || rates[(h>>12)&15] == 0 || samples[(h>>10)&3] == 0 || h&3 == 2 {
+			return errDirectAudio
+		}
+		signature := h & 0x00000cc0
+		if frames > 0 && signature != first {
+			return errDirectAudio
+		}
+		first = signature
+		length := int64(144000*rates[(h>>12)&15]/samples[(h>>10)&3] + int((h>>9)&1))
+		if length < 24 || length > size-pos {
+			return errDirectAudio
+		}
+		pos += length
+		frames++
+	}
+	if frames < 2 {
+		return errDirectAudio
+	}
+	return nil
+}
+
+// APEv2 at the end of audio, before optional ID3v1. Text only; binary/locator
+// items and leading/APE v1 variants are deliberately not admitted.
+func apeAudioEnd(r io.ReaderAt, start, end int64) (int64, error) {
+	if end-start < 32 {
+		return end, nil
+	}
+	footer, e := readDirect(r, end-32, 32)
+	if e != nil {
+		return 0, errDirectAudio
+	}
+	if string(footer[:8]) != "APETAGEX" {
+		return end, nil
+	}
+	version := binary.LittleEndian.Uint32(footer[8:12])
+	n := int64(binary.LittleEndian.Uint32(footer[12:16]))
+	count := binary.LittleEndian.Uint32(footer[16:20])
+	flags := binary.LittleEndian.Uint32(footer[20:24])
+	if version != 2000 || n < 32 || n > directMetadataLimit || n > end-start || count == 0 || count > 1024 || flags&^uint32(0x80000000) != 0 || !zeroBytes(footer[24:]) {
+		return 0, errDirectAudio
+	}
+	begin := end - n
+	b, e := readDirect(r, begin, n-32)
+	if e != nil {
+		return 0, errDirectAudio
+	}
+	if flags != 0 {
+		if begin-start < 32 {
+			return 0, errDirectAudio
+		}
+		header, e := readDirect(r, begin-32, 32)
+		if e != nil {
+			return 0, errDirectAudio
+		}
+		expected := bytes.Clone(footer)
+		binary.LittleEndian.PutUint32(expected[20:24], flags|0x20000000)
+		if !bytes.Equal(header, expected) {
+			return 0, errDirectAudio
+		}
+		begin -= 32
+	}
+	keys := map[string]bool{}
+	for i := uint32(0); i < count; i++ {
+		if len(b) < 11 {
+			return 0, errDirectAudio
+		}
+		n := uint64(binary.LittleEndian.Uint32(b[:4]))
+		flags := binary.LittleEndian.Uint32(b[4:8])
+		if flags&^uint32(1) != 0 {
+			return 0, errDirectAudio
+		}
+		k := bytes.IndexByte(b[8:], 0)
+		if k < 2 || k > 255 {
+			return 0, errDirectAudio
+		}
+		key := b[8 : 8+k]
+		for _, c := range key {
+			if c < 32 || c > 126 || c == '=' {
+				return 0, errDirectAudio
+			}
+		}
+		normalized := strings.ToLower(string(key))
+		if keys[normalized] || normalized == "id3" || normalized == "tag" || normalized == "oggs" || normalized == "mp+" {
+			return 0, errDirectAudio
+		}
+		keys[normalized] = true
+		b = b[9+k:]
+		if n > uint64(len(b)) || !utf8.Valid(b[:int(n)]) || bytes.Count(b[:int(n)], []byte{0}) > 1024 {
+			return 0, errDirectAudio
+		}
+		b = b[int(n):]
+	}
+	if len(b) != 0 {
+		return 0, errDirectAudio
+	}
+	return begin, nil
+}

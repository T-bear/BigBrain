+func replaceFixtureBox(b []byte, kind string, replacement []byte) []byte {
+	var out []byte
+	for len(b) > 0 {
+		n := int(binary.BigEndian.Uint32(b))
+		k := string(b[4:8])
+		part := b[:n]
+		if k == kind {
+			part = replacement
+		} else {
+			switch k {
+			case "moov", "trak", "mdia", "minf", "stbl":
+				part = boxFixture(k, replaceFixtureBox(b[8:n], kind, replacement))

diff --git a/internal/db/direct_import.go b/internal/db/direct_import.go
new file mode 100644
index 0000000..021bc2e
--- /dev/null
+++ b/internal/db/direct_import.go
@@ -0,0 +1,77 @@
+package db
+
+import (
+	"database/sql"
+	"encoding/json"
+	"errors"
+)
+
+// Direct imports share Librarr's durable owner; no torrent identity or retry authority.
+type DirectImport struct {
+	ID           string `json:"id"`
+	SHA256       string `json:"sha256"`
+	Format       string `json:"format"`
+	Name         string `json:"name"`
+	Size         int64  `json:"size"`
+	Status       string `json:"status"`
+	RelativePath string `json:"relativePath"`
+	Inode        string `json:"inode"`
+	LibraryID    string `json:"libraryId"`
+	ItemID       string `json:"itemId"`
+}
+
+func (d *DB) ReserveDirectImport(v DirectImport) (DirectImport, bool, error) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	tx, err := d.db.Begin()
+	if err != nil {
+		return v, false, err
+	}
+	defer tx.Rollback()
+	var raw string
+	err = tx.QueryRow("SELECT record FROM direct_audio_imports WHERE id=?", v.ID).Scan(&raw)
+	if err == nil {
+		var old DirectImport
+		if json.Unmarshal([]byte(raw), &old) != nil {
+			return v, false, errors.New("invalid retained record")
+		}
+		if old.SHA256 != v.SHA256 || old.Format != v.Format || old.Name != v.Name || old.Size != v.Size {
+			return v, false, errors.New("identity conflict")
+		}
+		return old, false, nil
+	}
+	// No read error is interpreted as absence.
+	if !errors.Is(err, sql.ErrNoRows) {
+		return v, false, err
+	}
+	var count int
+	if err = tx.QueryRow("SELECT COUNT(*) FROM direct_audio_imports").Scan(&count); err != nil {
+		return v, false, err
+	}
+	if count >= 200 {
+		return v, false, errors.New("import retention bound")
+	}
+	b, _ := json.Marshal(v)
+	if _, err = tx.Exec("INSERT INTO direct_audio_imports(id,record) VALUES(?,?)", v.ID, string(b)); err != nil {
+		return v, false, err
+	}
+	err = tx.Commit()
+	return v, err == nil, err
+}
+func (d *DB) ReadDirectImport(id string) (DirectImport, error) {
+	var raw string
+	var v DirectImport
+	err := d.db.QueryRow("SELECT record FROM direct_audio_imports WHERE id=?", id).Scan(&raw)
+	if err == nil {
+		err = json.Unmarshal([]byte(raw), &v)
+	}
+	return v, err
+}
+func (d *DB) SaveDirectImport(v DirectImport) error {
+	b, err := json.Marshal(v)
+	if err != nil {
+		return err
+	}
+	_, err = d.db.Exec("UPDATE direct_audio_imports SET record=? WHERE id=?", string(b), v.ID)
+	return err
+}
diff --git a/internal/organize/direct_audio.go b/internal/organize/direct_audio.go
new file mode 100644
index 0000000..a4e5198
--- /dev/null
+++ b/internal/organize/direct_audio.go
@@ -0,0 +1,95 @@
+package organize
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"syscall"
+)
+
+const DirectAudioLimit = 64 << 20
+
+var directID = regexp.MustCompile(`^[a-f0-9]{32}$`)
+var directName = regexp.MustCompile(`^[\pL\pN _().–'-]{1,80}$`)
+
+// PlaceDirectAudio keeps scanner-visible audio absent until all bytes are validated.
+// The existing no-overwrite directory reservation is reused; torrent placement is unchanged.
+// Configured roots/parents must be service-owned, not writable by untrusted local users.
+func (o *Organizer) PlaceDirectAudio(id, name, format, checksum string, size int64, body io.Reader) (relative, ino string, err error) {
+	if !o.cfg.FileOrgEnabled || !directID.MatchString(id) || !directName.MatchString(name) || name == "." || name == ".." || (format != "mp3" && format != "m4a") || size <= 0 || size > DirectAudioLimit {
+		return "", "", errors.New("invalid direct import")
+	}
+	root := o.cfg.AudiobookDir
+	if fi, e := os.Lstat(root); e != nil || !fi.IsDir() || fi.Mode()&os.ModeSymlink != 0 {
+		return "", "", errors.New("unsafe library root")
+	}
+	dir := filepath.Join(root, "BigBrain Imports", id)
+	if err = reserveAudiobookDestination(root, "BigBrain Imports", dir); err != nil {
+		return "", "", err
+	}
+	// Pin the reserved directory. Never remove the reservation after any uncertain outcome.
+	r, e := os.OpenRoot(dir)
+	if e != nil {
+		return "", "", e
+	}
+	defer r.Close()
+	f, e := r.OpenFile(".pending", os.O_CREATE|os.O_EXCL|os.O_RDWR, 0600)
+	if e != nil {
+		return "", "", e
+	}
+	defer f.Close()
+	defer r.Remove(".pending") // only the exact file created by this call, never other contents
+	h := sha256.New()
+	n, e := io.Copy(io.MultiWriter(f, h), io.LimitReader(body, DirectAudioLimit+1))
+	if e != nil || n != size || hex.EncodeToString(h.Sum(nil)) != checksum {
+		return "", "", errors.New("size or checksum mismatch")
+	}
+	if _, e = f.Seek(0, 0); e != nil {
+		return "", "", e
+	}
+	if e = ValidateDirectAudio(f, n, format); e != nil {
+		return "", "", e
+	}
+	if e = f.Sync(); e != nil {
+		return "", "", e
+	}
+	if e = f.Chmod(0444); e != nil {
+		return "", "", e
+	}
+	filename := name + " -- " + id + "." + format
+	// Exclusive hardlink publication: fails if *anything* already owns this filename.
+	if e = r.Link(".pending", filename); e != nil {
+		return "", "", e
+	}
+	if e = syncDirectDir(dir); e != nil {
+		return "", "", e
+	}
+	if e = syncDirectDir(filepath.Dir(dir)); e != nil {
+		return "", "", e
+	}
+	if e = syncDirectDir(root); e != nil {
+		return "", "", e
+	}
+	info, e := f.Stat()
+	if e != nil {
+		return "", "", e
+	}
+	st, ok := info.Sys().(*syscall.Stat_t)
+	if !ok {
+		return "", "", errors.New("inode unavailable")
+	}
+	return filepath.ToSlash(filepath.Join("BigBrain Imports", id, filename)), strconv.FormatUint(st.Ino, 10), nil
+}
+func syncDirectDir(path string) error {
+	f, e := os.Open(path)
+	if e != nil {
+		return e
+	}
+	defer f.Close()
+	return f.Sync()
+}
diff --git a/internal/organize/direct_audio_test.go b/internal/organize/direct_audio_test.go
new file mode 100644
index 0000000..47105f7
--- /dev/null
+++ b/internal/organize/direct_audio_test.go
@@ -0,0 +1,93 @@
+package organize
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+)
+
+func directFixture() []byte {
+	frame := make([]byte, 417)
+	copy(frame, []byte{0xff, 0xfb, 0x90, 0})
+	return append(frame, frame...)
+}
+func TestDirectAudioValidation(t *testing.T) {
+	b := directFixture()
+	for _, c := range []struct {
+		b      []byte
+		format string
+		good   bool
+	}{{b, "mp3", true}, {b, "m4a", false}, {b[:len(b)-1], "mp3", false}, {append([]byte("ID3"), b...), "mp3", false}, {[]byte("<html>not audio</html>"), "mp3", false}} {
+		if e := ValidateDirectAudio(bytes.NewReader(c.b), int64(len(c.b)), c.format); (e == nil) != c.good {
+			t.Fatalf("validation: %v", e)
+		}
+	}
+}
+func TestDirectPlacementExclusiveConcurrentAndPartial(t *testing.T) {
+	o, _, library := audiobookOrganizer(t, "copy")
+	os.MkdirAll(library, 0755)
+	b := directFixture()
+	sum := fmt.Sprintf("%x", sha256.Sum256(b))
+	id := "11111111111111111111111111111111"
+	var wg sync.WaitGroup
+	results := make(chan string, 8)
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			rel, ino, e := o.PlaceDirectAudio(id, "Chapter", "mp3", sum, int64(len(b)), bytes.NewReader(b))
+			if e == nil {
+				if ino == "" {
+					t.Error("missing inode")
+				}
+				results <- rel
+			}
+		}()
+	}
+	wg.Wait()
+	close(results)
+	var paths []string
+	for p := range results {
+		paths = append(paths, p)
+	}
+	if len(paths) != 1 {
+		t.Fatalf("successful placements %d", len(paths))
+	}
+	actual, e := os.ReadFile(filepath.Join(library, paths[0]))
+	if e != nil || !bytes.Equal(actual, b) {
+		t.Fatal("bytes changed")
+	}
+	if _, e = os.Stat(filepath.Join(library, "BigBrain Imports", id, ".pending")); !os.IsNotExist(e) {
+		t.Fatal("staging not cleaned")
+	}
+	id = "22222222222222222222222222222222"
+	if _, _, e = o.PlaceDirectAudio(id, "Chapter", "mp3", sum, int64(len(b)), bytes.NewReader(b[:5])); e == nil {
+		t.Fatal("accepted partial")
+	}
+	if _, _, e = o.PlaceDirectAudio(id, "Chapter", "mp3", sum, int64(len(b)), bytes.NewReader(b)); e == nil {
+		t.Fatal("reused uncertain reservation")
+	}
+}
+func TestDirectPlacementRejectsSymlinkAndBadChecksum(t *testing.T) {
+	o, _, library := audiobookOrganizer(t, "move")
+	os.MkdirAll(library, 0755)
+	other := t.TempDir()
+	os.Symlink(other, filepath.Join(library, "BigBrain Imports"))
+	b := directFixture()
+	sum := fmt.Sprintf("%x", sha256.Sum256(b))
+	if _, _, e := o.PlaceDirectAudio("11111111111111111111111111111111", "Title", "mp3", sum, int64(len(b)), bytes.NewReader(b)); e == nil {
+		t.Fatal("symlink admitted")
+	}
+	entries, _ := os.ReadDir(other)
+	if len(entries) != 0 {
+		t.Fatal("escaped root")
+	}
+	os.Remove(filepath.Join(library, "BigBrain Imports"))
+	if _, _, e := o.PlaceDirectAudio("11111111111111111111111111111111", "Title", "mp3", "bad", int64(len(b)), bytes.NewReader(b)); e == nil {
+		t.Fatal("bad checksum accepted")
+	}
+}
diff --git a/internal/organize/direct_audio_validation.go b/internal/organize/direct_audio_validation.go
new file mode 100644
index 0000000..90f050f
--- /dev/null
+++ b/internal/organize/direct_audio_validation.go
@@ -0,0 +1,49 @@
+package organize
+
+import (
+	"encoding/binary"
+	"errors"
+	"io"
+)
+
+var errDirectAudio = errors.New("unsupported or malformed audio")
+
+// Deliberately narrow, bounded structural admission. No native decoder or external process.
+// MP3: MPEG1 LayerIII full frames only (no ID3/APE payloads). M4A stays denied until
+// sample-table/codec validation is independently implemented; an ftyp signature is insufficient.
+func ValidateDirectAudio(r io.ReaderAt, size int64, format string) error {
+	if format != "mp3" || size < 8 || size > DirectAudioLimit {
+		return errDirectAudio
+	}
+	rates := [16]int{0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 0}
+	samples := [4]int{44100, 48000, 32000, 0}
+	var pos int64
+	frames := 0
+	var first uint32
+	for pos < size {
+		var b [4]byte
+		if _, e := r.ReadAt(b[:], pos); e != nil {
+			return errDirectAudio
+		}
+		h := binary.BigEndian.Uint32(b[:])
+		// MPEG1, LayerIII, valid sample/bit rates; reserved emphasis forbidden.
+		if h&0xfffe0000 != 0xfffa0000 || rates[(h>>12)&15] == 0 || samples[(h>>10)&3] == 0 || h&3 == 2 {
+			return errDirectAudio
+		}
+		signature := h & 0x00000cc0 // fixed sample rate/channel mode across frames
+		if frames > 0 && signature != first {
+			return errDirectAudio
+		}
+		first = signature
+		length := int64(144000*rates[(h>>12)&15]/samples[(h>>10)&3] + int((h>>9)&1))
+		if length < 24 || pos+length > size {
+			return errDirectAudio
+		}
+		pos += length
+		frames++
+	}
+	if frames < 2 {
+		return errDirectAudio
+	}
+	return nil
+}

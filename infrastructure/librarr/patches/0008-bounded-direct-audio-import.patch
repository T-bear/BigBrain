+	overlap = replaceFixtureBox(overlap, "stsc", boxFixture("stsc", wordsFixture(0, 1, 1, 1, 1)))
+	corrupt := bytes.Clone(tagged)
+	p := bytes.Index(corrupt, []byte("data")) - 4

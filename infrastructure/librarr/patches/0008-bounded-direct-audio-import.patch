diff --git a/internal/organize/direct_m4a_validation.go b/internal/organize/direct_m4a_validation.go
new file mode 100644
index 0000000..f8a2a83
--- /dev/null
+++ b/internal/organize/direct_m4a_validation.go
@@ -0,0 +1,516 @@
+package organize
+
+import (
+	"bytes"
+	"encoding/binary"
+	"io"
+
+	"github.com/Eyevinn/mp4ff/aac"
+	"github.com/Eyevinn/mp4ff/mp4"
+)
+
+// Bounded progressive AAC-LC admission, not a general decoder. Envelopes and
+// allocation-driving counts are checked BEFORE mp4ff sees individual leaves.
+type directBox struct {
+	kind      string
+	raw, body []byte
+}
+
+func directBoxes(b []byte, budget *int) ([]directBox, error) {
+	var out []directBox
+	for len(b) > 0 {
+		if len(b) < 8 || *budget <= 0 {
+			return nil, errDirectAudio
+		}
+		*budget--
+		n := uint64(binary.BigEndian.Uint32(b))
+		if n < 8 || n > uint64(len(b)) {
+			return nil, errDirectAudio
+		}
+		out = append(out, directBox{string(b[4:8]), b[:int(n)], b[8:int(n)]})
+		b = b[int(n):]
+	}
+	return out, nil
+}
+func oneBox(boxes []directBox, kind string) (directBox, error) {
+	var found directBox
+	n := 0
+	for _, b := range boxes {
+		if b.kind == kind {
+			found = b
+			n++
+		}
+	}
+	if n != 1 {
+		return found, errDirectAudio
+	}
+	return found, nil
+}
+func allowedBoxes(boxes []directBox, kinds ...string) bool {
+	seen := map[string]bool{}
+	for _, b := range boxes {
+		ok := false
+		for _, k := range kinds {
+			if b.kind == k {
+				ok = true
+			}
+		}
+		if !ok || seen[b.kind] && b.kind != "free" {
+			return false
+		}
+		seen[b.kind] = true
+	}
+	return true
+}
+func fullZero(b []byte) bool                        { return len(b) >= 4 && zeroBytes(b[:4]) }
+func decodeDirectLeaf(b directBox) (mp4.Box, error) { return mp4.DecodeBox(0, bytes.NewReader(b.raw)) }
+func validateDirectM4A(r io.ReaderAt, size int64) error {
+	budget := 512
+	var movie []byte
+	var dataStart, dataEnd int64
+	ftyp := false
+	for pos := int64(0); pos < size; {
+		h, e := readDirect(r, pos, 8)
+		if e != nil || budget <= 0 {
+			return errDirectAudio
+		}
+		budget--
+		n := int64(binary.BigEndian.Uint32(h))
+		head := int64(8)
+		kind := string(h[4:])
+		if n == 1 && kind == "mdat" {
+			ext, e := readDirect(r, pos+8, 8)
+			if e != nil {
+				return errDirectAudio
+			}
+			u := binary.BigEndian.Uint64(ext)
+			if u > uint64(size-pos) {
+				return errDirectAudio
+			}
+			n = int64(u)
+			head = 16
+		}
+		if n < head || n > size-pos {
+			return errDirectAudio
+		}
+		switch kind {
+		case "ftyp":
+			if pos != 0 || ftyp || n < 16 || n > 128 || (n-16)%4 != 0 {
+				return errDirectAudio
+			}
+			b, e := readDirect(r, pos+8, n-8)
+			if e != nil {
+				return errDirectAudio
+			}
+			brand := string(b[:4])
+			if brand != "M4A " && brand != "isom" && brand != "mp42" {
+				return errDirectAudio
+			}
+			ftyp = true
+		case "moov":
+			if movie != nil || n > directMetadataLimit {
+				return errDirectAudio
+			}
+			movie, e = readDirect(r, pos+8, n-8)
+			if e != nil {
+				return errDirectAudio
+			}
+		case "mdat":
+			if dataEnd != 0 || n == head {
+				return errDirectAudio
+			}
+			dataStart = pos + head
+			dataEnd = pos + n
+		case "free": // never materialized
+		default:
+			return errDirectAudio // includes fragments, DRM and reference movies
+		}
+		pos += n
+	}
+	if !ftyp || movie == nil || dataEnd == 0 {
+		return errDirectAudio
+	}
+	moov, e := directBoxes(movie, &budget)
+	if e != nil || !allowedBoxes(moov, "mvhd", "trak", "udta", "free") {
+		return errDirectAudio
+	}
+	mvhd, e := oneBox(moov, "mvhd")
+	if e != nil || len(mvhd.body) != 100 || !fullZero(mvhd.body) || binary.BigEndian.Uint32(mvhd.body[12:16]) == 0 || binary.BigEndian.Uint32(mvhd.body[16:20]) == 0 {
+		return errDirectAudio
+	}
+	for _, b := range moov {
+		if b.kind == "udta" && !directMetadata(b.body, &budget) {
+			return errDirectAudio
+		}
+	}
+	track, e := oneBox(moov, "trak")
+	if e != nil {
+		return errDirectAudio
+	}
+	trak, e := directBoxes(track.body, &budget)
+	if e != nil || !allowedBoxes(trak, "tkhd", "mdia", "edts") {
+		return errDirectAudio
+	}
+	tkhd, e := oneBox(trak, "tkhd")
+	if e != nil || len(tkhd.body) != 84 || tkhd.body[0] != 0 || binary.BigEndian.Uint32(tkhd.body[12:16]) == 0 {
+		return errDirectAudio
+	}
+	media, e := oneBox(trak, "mdia")
+	if e != nil {
+		return errDirectAudio
+	}
+	mdia, e := directBoxes(media.body, &budget)
+	if e != nil || !allowedBoxes(mdia, "mdhd", "hdlr", "minf") {
+		return errDirectAudio
+	}
+	mdhd, e := oneBox(mdia, "mdhd")
+	if e != nil || len(mdhd.body) != 24 || !fullZero(mdhd.body) {
+		return errDirectAudio
+	}
+	timescale := binary.BigEndian.Uint32(mdhd.body[12:16])
+	duration := binary.BigEndian.Uint32(mdhd.body[16:20])
+	if timescale == 0 || duration == 0 {
+		return errDirectAudio
+	}
+	movieScale := binary.BigEndian.Uint32(mvhd.body[12:16])
+	trackDuration := binary.BigEndian.Uint32(tkhd.body[20:24])
+	if trackDuration == 0 || trackDuration > binary.BigEndian.Uint32(mvhd.body[16:20]) {
+		return errDirectAudio
+	}
+	hasEdits := false
+	for _, b := range trak {
+		if b.kind == "edts" {
+			hasEdits = true
+			if !directEdits(b.body, &budget, movieScale, timescale, trackDuration, duration) {
+				return errDirectAudio
+			}
+		}
+	}
+	if !hasEdits {
+		actual := uint64(trackDuration) * uint64(timescale)
+		expected := uint64(duration) * uint64(movieScale)
+		tolerance := uint64(timescale)
+		if actual > expected+tolerance || expected > actual+tolerance {
+			return errDirectAudio
+		}
+	}
+	hdlr, e := oneBox(mdia, "hdlr")
+	if e != nil || len(hdlr.body) < 24 || !fullZero(hdlr.body) || string(hdlr.body[8:12]) != "soun" {
+		return errDirectAudio
+	}
+	min, e := oneBox(mdia, "minf")
+	if e != nil {
+		return errDirectAudio
+	}
+	minf, e := directBoxes(min.body, &budget)
+	if e != nil || !allowedBoxes(minf, "smhd", "dinf", "stbl") {
+		return errDirectAudio
+	}
+	smhd, e := oneBox(minf, "smhd")
+	if e != nil || len(smhd.body) != 8 || !fullZero(smhd.body) {
+		return errDirectAudio
+	}
+	dinf, e := oneBox(minf, "dinf")
+	if e != nil || !directDataReference(dinf.body, &budget) {
+		return errDirectAudio
+	}
+	table, e := oneBox(minf, "stbl")
+	if e != nil {
+		return errDirectAudio
+	}
+	stbl, e := directBoxes(table.body, &budget)
+	if e != nil || !allowedBoxes(stbl, "stsd", "stsz", "stsc", "stts", "stco", "co64") {
+		return errDirectAudio
+	}
+	stsd, e := oneBox(stbl, "stsd")
+	if e != nil || len(stsd.body) < 8 || !fullZero(stsd.body) || binary.BigEndian.Uint32(stsd.body[4:8]) != 1 {
+		return errDirectAudio
+	}
+	entries, e := directBoxes(stsd.body[8:], &budget)
+	if e != nil || len(entries) != 1 || entries[0].kind != "mp4a" {
+		return errDirectAudio
+	}
+	if !directAAC(entries[0].body, &budget, timescale) {
+		return errDirectAudio
+	}
+	return directSampleTables(stbl, dataStart, dataEnd, duration)
+}
+func directDataReference(b []byte, budget *int) bool {
+	boxes, e := directBoxes(b, budget)
+	if e != nil || len(boxes) != 1 || boxes[0].kind != "dref" {
+		return false
+	}
+	b = boxes[0].body
+	if len(b) < 8 || !fullZero(b) || binary.BigEndian.Uint32(b[4:8]) != 1 {
+		return false
+	}
+	refs, e := directBoxes(b[8:], budget)
+	return e == nil && len(refs) == 1 && refs[0].kind == "url " && bytes.Equal(refs[0].body, []byte{0, 0, 0, 1})
+}
+func directAAC(b []byte, budget *int, timescale uint32) bool {
+	if len(b) < 28 || !zeroBytes(b[:6]) || binary.BigEndian.Uint16(b[6:8]) != 1 || !zeroBytes(b[8:16]) || binary.BigEndian.Uint16(b[18:20]) != 16 || !zeroBytes(b[20:24]) {
+		return false
+	}
+	channels := binary.BigEndian.Uint16(b[16:18])
+	rate := binary.BigEndian.Uint32(b[24:28])
+	if channels < 1 || channels > 2 || rate&0xffff != 0 || rate>>16 != timescale {
+		return false
+	}
+	children, e := directBoxes(b[28:], budget)
+	if e != nil || !allowedBoxes(children, "esds", "btrt") {
+		return false
+	}
+	esds, e := oneBox(children, "esds")
+	if e != nil || len(esds.body) > 4096 || !fullZero(esds.body) || !directDescriptors(esds.body[4:]) {
+		return false
+	}
+	for _, child := range children {
+		if child.kind == "btrt" && len(child.body) != 12 {
+			return false
+		}
+	}
+	decoded, e := decodeDirectLeaf(esds)
+	if e != nil {
+		return false
+	}
+	descriptor, ok := decoded.(*mp4.EsdsBox)
+	if !ok {
+		return false
+	}
+	d := descriptor.DecConfigDescriptor
+	if d == nil || d.ObjectType != 0x40 || d.StreamType != 0x15 || d.DecSpecificInfo == nil {
+		return false
+	}
+	config := d.DecSpecificInfo.DecConfig
+	if len(config) != 2 || config[1]&7 != 0 {
+		return false
+	}
+	asc, e := aac.DecodeAudioSpecificConfig(bytes.NewReader(config))
+	return e == nil && asc.ObjectType == aac.AAClc && asc.SamplingFrequency == int(timescale) && asc.ChannelConfiguration == byte(channels) && descriptor.Flags == 0
+}
+func directSampleTables(boxes []directBox, start, end int64, duration uint32) error {
+	var sizes *mp4.StszBox
+	var chunks *mp4.StscBox
+	var timing *mp4.SttsBox
+	var offsets []uint64
+	for _, b := range boxes {
+		if b.kind == "stsd" {
+			continue
+		}
+		if len(b.body) < 8 || !fullZero(b.body) {
+			return errDirectAudio
+		}
+		count := binary.BigEndian.Uint32(b.body[4:8])
+		base, width := 8, 4
+		switch b.kind {
+		case "stsz":
+			if len(b.body) < 12 {
+				return errDirectAudio
+			}
+			count = binary.BigEndian.Uint32(b.body[8:12])
+			base = 12
+			if binary.BigEndian.Uint32(b.body[4:8]) != 0 {
+				width = 0
+			}
+		case "stsc":
+			width = 12
+		case "stts", "co64":
+			width = 8
+		}
+		if count == 0 || count > 1000000 || uint64(len(b.body)) != uint64(base)+uint64(count)*uint64(width) {
+			return errDirectAudio
+		}
+		v, e := decodeDirectLeaf(b)
+		if e != nil {
+			return errDirectAudio
+		}
+		switch v := v.(type) {
+		case *mp4.StszBox:
+			sizes = v
+		case *mp4.StscBox:
+			chunks = v
+		case *mp4.SttsBox:
+			timing = v
+		case *mp4.StcoBox:
+			if offsets != nil {
+				return errDirectAudio
+			}
+			for _, o := range v.ChunkOffset {
+				offsets = append(offsets, uint64(o))
+			}
+		case *mp4.Co64Box:
+			if offsets != nil {
+				return errDirectAudio
+			}
+			offsets = v.ChunkOffset
+		default:
+			return errDirectAudio
+		}
+	}
+	if sizes == nil || chunks == nil || timing == nil || len(offsets) == 0 || len(chunks.Entries) == 0 || chunks.Entries[0].FirstChunk != 1 {
+		return errDirectAudio
+	}
+	var sampleCount, totalDuration uint64
+	for i, n := range timing.SampleCount {
+		if n == 0 || timing.SampleTimeDelta[i] == 0 || uint64(n) > uint64(sizes.SampleNumber)-sampleCount {
+			return errDirectAudio
+		}
+		sampleCount += uint64(n)
+		totalDuration += uint64(n) * uint64(timing.SampleTimeDelta[i])
+		if totalDuration > uint64(duration) {
+			return errDirectAudio
+		}
+	}
+	if sampleCount != uint64(sizes.SampleNumber) || totalDuration != uint64(duration) {
+		return errDirectAudio
+	}
+	for i, c := range chunks.Entries {
+		if c.FirstChunk == 0 || c.FirstChunk > uint32(len(offsets)) || c.SamplesPerChunk == 0 || c.SamplesPerChunk > sizes.SampleNumber || i > 0 && c.FirstChunk <= chunks.Entries[i-1].FirstChunk || chunks.GetSampleDescriptionID(i+1) != 1 {
+			return errDirectAudio
+		}
+	}
+	sample, entry := 1, 0
+	next := uint64(start)
+	for i, offset := range offsets {
+		if entry+1 < len(chunks.Entries) && chunks.Entries[entry+1].FirstChunk == uint32(i+1) {
+			entry++
+		}
+		if offset != next {
+			return errDirectAudio
+		}
+		for j := uint32(0); j < chunks.Entries[entry].SamplesPerChunk; j++ {
+			if sample > int(sizes.SampleNumber) {
+				return errDirectAudio
+			}
+			n := sizes.GetSampleSize(sample)
+			if n == 0 || n > 1<<20 || uint64(n) > uint64(end)-next {
+				return errDirectAudio
+			}
+			next += uint64(n)
+			sample++
+		}
+	}
+	if sample != int(sizes.SampleNumber)+1 || next != uint64(end) {
+		return errDirectAudio
+	}
+	return nil
+}
+
+// Common iTunes metadata box envelopes; values remain opaque and are never rendered.
+func directMetadata(b []byte, budget *int) bool {
+	boxes, e := directBoxes(b, budget)
+	if e != nil || !allowedBoxes(boxes, "meta") {
+		return false
+	}
+	for _, m := range boxes {
+		if !fullZero(m.body) {
+			return false
+		}
+		children, e := directBoxes(m.body[4:], budget)
+		if e != nil || !allowedBoxes(children, "hdlr", "ilst") {
+			return false
+		}
+		for _, c := range children {
+			if c.kind == "hdlr" {
+				if len(c.body) < 24 || !fullZero(c.body) {
+					return false
+				}
+				continue
+			}
+			items, e := directBoxes(c.body, budget)
+			if e != nil {
+				return false
+			}
+			for _, item := range items {
+				values, e := directBoxes(item.body, budget)
+				if e != nil {
+					return false
+				}
+				for _, v := range values {
+					if v.kind != "data" || len(v.body) < 8 {
+						return false
+					}
+				}
+			}
+		}
+	}
+	return true
+}
+func directEdits(b []byte, budget *int, movieScale, mediaScale, trackDuration, mediaDuration uint32) bool {
+	boxes, e := directBoxes(b, budget)
+	if e != nil || len(boxes) != 1 || boxes[0].kind != "elst" {
+		return false
+	}
+	b = boxes[0].body
+	if len(b) < 8 || !fullZero(b) {
+		return false
+	}
+	n := binary.BigEndian.Uint32(b[4:8])
+	if n == 0 || n > 2 || len(b) != 8+int(n)*12 {
+		return false
+	}
+	var total uint64
+	for p := 8; p < len(b); p += 12 {
+		segment := binary.BigEndian.Uint32(b[p : p+4])
+		mediaTime := int32(binary.BigEndian.Uint32(b[p+4 : p+8]))
+		if segment == 0 || mediaTime < -1 || !bytes.Equal(b[p+8:p+12], []byte{0, 1, 0, 0}) {
+			return false
+		}
+		total += uint64(segment)
+		if total > uint64(trackDuration) {
+			return false
+		}
+		if mediaTime >= 0 {
+			if uint32(mediaTime) >= mediaDuration {
+				return false
+			}
+			// At most one movie tick of duration rounding, never a range beyond the media.
+			if uint64(segment)*uint64(mediaScale) > uint64(mediaDuration-uint32(mediaTime))*uint64(movieScale)+uint64(mediaScale) {
+				return false
+			}
+		}
+	}
+	if total != uint64(trackDuration) {
+		return false
+	}
+
+	return true
+}
+
+// Validate the exact finite ES -> DecoderConfig -> AAC config + SL tree first.
+// Reject URL/dependent streams, extra descriptors and overlong/truncated length fields.
+func takeDirectDescriptor(b []byte, tag byte) (body, rest []byte, ok bool) {
+	if len(b) < 2 || b[0] != tag {
+		return nil, nil, false
+	}
+	n := 0
+	for i := 1; i <= 4; i++ {
+		if i >= len(b) {
+			return nil, nil, false
+		}
+		n = n<<7 | int(b[i]&127)
+		if b[i]&128 == 0 {
+			if n > len(b)-i-1 {
+				return nil, nil, false
+			}
+			return b[i+1 : i+1+n], b[i+1+n:], true
+		}
+	}
+	return nil, nil, false
+}
+func directDescriptors(b []byte) bool {
+	es, rest, ok := takeDirectDescriptor(b, 3)
+	if !ok || len(rest) != 0 || len(es) < 3 || es[2]&0xe0 != 0 {
+		return false
+	}
+	dec, rest, ok := takeDirectDescriptor(es[3:], 4)
+	if !ok || len(dec) < 13 {
+		return false
+	}
+	config, tail, ok := takeDirectDescriptor(dec[13:], 5)
+	if !ok || len(config) != 2 || len(tail) != 0 {
+		return false
+	}
+	sl, tail, ok := takeDirectDescriptor(rest, 6)
+	return ok && len(tail) == 0 && bytes.Equal(sl, []byte{2})
+}

+// discoveryQueries keeps ordinary searches unchanged and adds at most two
+// author-aware audiobook variants. Normalized duplicates are removed before
+// any source is called.
+func discoveryQueries(tab, query, author string) []string {
+	query = strings.Join(strings.Fields(query), " ")
+	author = strings.Join(strings.Fields(author), " ")
+	variants := []string{query}
+	if tab == "audiobook" && author != "" {
+		if !containsNormalizedPhrase(query, author) {
+			variants = append(variants, query+" "+author)
+		}
+		words := strings.Fields(query)
+		if len(words) > 1 {
+			switch strings.ToLower(words[0]) {
+			case "a", "an", "the":
+				variants = append(variants, strings.Join(words[1:], " ")+" "+author)
+			}
+		}
+	}
 
-	elapsed := time.Since(start).Milliseconds()
-	return results, elapsed
+	seen := make(map[string]struct{}, len(variants))
+	bounded := make([]string, 0, len(variants))
+	for _, variant := range variants {
+		normalized := strings.ToLower(strings.Join(strings.Fields(variant), " "))
+		if normalized == "" {
+			continue
+		}
+		if _, duplicate := seen[normalized]; duplicate {
+			continue
+		}
+		seen[normalized] = struct{}{}
+		bounded = append(bounded, variant)
+		if len(bounded) == 3 {
+			break
+		}
+	}
+	return bounded
+}
+
+func containsNormalizedPhrase(value, phrase string) bool {
+	valueWords := strings.Fields(strings.ToLower(value))
+	phraseWords := strings.Fields(strings.ToLower(phrase))
+	if len(phraseWords) == 0 || len(phraseWords) > len(valueWords) {
+		return false
+	}
+	for i := 0; i <= len(valueWords)-len(phraseWords); i++ {
+		if strings.Join(valueWords[i:i+len(phraseWords)], " ") == strings.Join(phraseWords, " ") {
+			return true
+		}
+	}
+	return false
 }
 

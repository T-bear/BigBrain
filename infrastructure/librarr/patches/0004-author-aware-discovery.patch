+++ b/internal/search/discovery_query_test.go
@@ -0,0 +1,93 @@
+package search
+
+import (
+	"context"
+	"errors"
+	"reflect"
+	"sync"
+	"testing"
+
+	"github.com/JeremiahM37/librarr/internal/config"
+	"github.com/JeremiahM37/librarr/internal/models"
+)
+
+func TestDiscoveryQueriesAreBoundedAndAuthorAware(t *testing.T) {
+	tests := []struct {
+		name, tab, query, author string
+		want                     []string
+	}{
+		{"title only", "audiobook", "The Wandering Inn", "", []string{"The Wandering Inn"}},
+		{"title and author", "audiobook", "The Wandering Inn", "pirateaba", []string{"The Wandering Inn", "The Wandering Inn pirateaba", "Wandering Inn pirateaba"}},
+		{"normalized duplicates", "audiobook", "  Book   pirateaba  ", "PIRATEABA", []string{"Book pirateaba"}},
+		{"other tabs unchanged", "main", "The Wandering Inn", "pirateaba", []string{"The Wandering Inn"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := discoveryQueries(tc.tab, tc.query, tc.author); !reflect.DeepEqual(got, tc.want) {
+				t.Fatalf("discoveryQueries() = %#v, want %#v", got, tc.want)
+			}
+		})
+	}
+}
+
+type recordingSearcher struct {
+	name    string
+	mu      sync.Mutex
+	queries []string
+}
+
+func (s *recordingSearcher) Name() string         { return s.name }
+func (s *recordingSearcher) Label() string        { return s.name }
+func (s *recordingSearcher) Enabled() bool        { return true }
+func (s *recordingSearcher) SearchTab() string    { return "audiobook" }
+func (s *recordingSearcher) DownloadType() string { return "torrent" }
+func (s *recordingSearcher) Search(_ context.Context, query string) ([]models.SearchResult, error) {
+	s.mu.Lock()
+	s.queries = append(s.queries, query)
+	s.mu.Unlock()
+	if query == "The Wandering Inn" {
+		return nil, errors.New("one variant failed")
+	}
+	return []models.SearchResult{{Source: "prowlarr_audiobooks", Title: "The Wandering Inn English", InfoHash: query}}, nil
+}
+
+func TestSearchWithAuthorReachesSourcesAndKeepsPartialSuccess(t *testing.T) {
+	source := &recordingSearcher{name: "prowlarr_audiobooks"}
+	mgr := NewManager(&config.Config{}, []Searcher{source}, NewHealthTracker(3, 300))
+	results, _ := mgr.SearchWithAuthor(context.Background(), "audiobook", "The Wandering Inn", "pirateaba")
+
+	source.mu.Lock()
+	gotQueries := append([]string(nil), source.queries...)
+	source.mu.Unlock()
+	wantQueries := []string{"The Wandering Inn", "The Wandering Inn pirateaba", "Wandering Inn pirateaba"}
+	for _, want := range wantQueries {
+		if !containsString(gotQueries, want) {
+			t.Fatalf("source queries = %#v, missing %q", gotQueries, want)
+		}
+	}
+	if len(results) == 0 {
+		t.Fatal("successful variants must survive a partial variant failure")
+	}
+}
+
+func TestProwlarrAudiobookSuffixIsNotDuplicated(t *testing.T) {
+	p := &Prowlarr{tab: "audiobook"}
+	for _, query := range []string{"Book audiobook", "Book audio book", "Book ljudbok"} {
+		variants := p.searchVariants(query, []string{"3030"})
+		if variants[1].query != query {
+			t.Fatalf("generic query = %q, want %q", variants[1].query, query)
+		}
+	}
+	if got := p.searchVariants("Book", []string{"3030"})[1].query; got != "Book audiobook" {
+		t.Fatalf("generic query = %q, want audiobook suffix", got)
+	}
+}
+
+func containsString(values []string, target string) bool {
+	for _, value := range values {
+		if value == target {
+			return true
+		}
+	}
+	return false
+}

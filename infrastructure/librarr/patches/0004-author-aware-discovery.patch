+func containsAudiobookTerm(query string) bool {
+	normalized := strings.ToLower(strings.Join(strings.Fields(query), " "))
+	for _, term := range []string{"audiobook", "audio book", "ljudbok"} {
+		if strings.Contains(normalized, term) {
+			return true
+		}
+	}
+	return false
+}

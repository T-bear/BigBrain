+func TestAudioBookBaySearchQueryIsSourceSpecificallyLowercased(t *testing.T) {
+	tests := []struct {
+		name  string
+		query string
+		want  string
+	}{
+		{name: "author title case", query: "Pirateaba", want: "pirateaba"},
+		{name: "author lower case", query: "pirateaba", want: "pirateaba"},
+		{name: "author upper case", query: "PIRATEABA", want: "pirateaba"},
+		{name: "book title case", query: "The Wandering Inn", want: "the wandering inn"},
+		{name: "book lower case", query: "the wandering inn", want: "the wandering inn"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rt := &abbRoundTripper{body: "<html><body></body></html>"}
+			reg, err := sourcestest.Registry()
+			if err != nil {
+				t.Fatalf("load registry: %v", err)
+			}
+			cfg := &config.Config{UserAgent: "test", Sources: reg}
+			cfg.Sources.AudioBookBay.Mirrors = []string{"fixture.invalid"}
+			a := &AudioBookBay{cfg: cfg, client: &http.Client{Transport: rt}}
+
+			if _, err := a.searchDomain(context.Background(), "fixture.invalid", tt.query); err != nil {
+				t.Fatalf("searchDomain returned error: %v", err)
+			}
+			if got := rt.req.URL.Query().Get("s"); got != tt.want {
+				t.Fatalf("source query = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}

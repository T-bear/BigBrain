# Copy this file to .env and replace only the credential placeholders.
# .env is ignored by Git. Never commit real credentials.

MEDIA_DOCKER_NETWORK=bigbrain_default
FLARESOLVERR_PORT=8191
FLARESOLVERR_LOG_LEVEL=info
MEDIA__TIMEOUTSECONDS=3
MEDIA__REQUESTS__ENABLED=true
MEDIA__REQUESTS__DEFAULTSEARCHAFTERADD=false
MEDIA__REQUESTS__PREVIEWTOKENLIFETIMEMINUTES=5
MEDIA__REQUESTS__MAXIMUMCONCURRENTREQUESTS=1

MEDIA__JELLYFIN__BASEURL=http://jellyfin:8096
MEDIA__JELLYFIN__APIKEY=
MEDIA__JELLYFIN__USERID=
MEDIA__SMARTSHUFFLE__ENABLED=false
MEDIA__SMARTSHUFFLE__REQUESTTIMEOUTSECONDS=15
MEDIA__SMARTSHUFFLE__PLAYBACKCONFIRMATIONSECONDS=20

MEDIA__SONARR__BASEURL=http://sonarr:8989
MEDIA__SONARR__APIKEY=

MEDIA__RADARR__BASEURL=http://radarr:7878
MEDIA__RADARR__APIKEY=

MEDIA__PROWLARR__BASEURL=http://prowlarr:9696
MEDIA__PROWLARR__APIKEY=

MEDIA__QBITTORRENT__BASEURL=http://qbittorrent:8080
MEDIA__QBITTORRENT__APIKEY=

# Optional browser-facing Web UI links, separate from internal adapter URLs.
MEDIA__SERVICELINKS__JELLYFIN__URL=
MEDIA__SERVICELINKS__JELLYFIN__ENABLED=false
MEDIA__SERVICELINKS__RADARR__URL=
MEDIA__SERVICELINKS__RADARR__ENABLED=false
MEDIA__SERVICELINKS__SONARR__URL=
MEDIA__SERVICELINKS__SONARR__ENABLED=false
MEDIA__SERVICELINKS__PROWLARR__URL=
MEDIA__SERVICELINKS__PROWLARR__ENABLED=false
MEDIA__SERVICELINKS__QBITTORRENT__URL=
MEDIA__SERVICELINKS__QBITTORRENT__ENABLED=false

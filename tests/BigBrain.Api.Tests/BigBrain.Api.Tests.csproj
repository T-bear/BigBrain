<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/BigBrain.Api/BigBrain.Api.csproj" />
    <ProjectReference Include="../BigBrain.Reasoner.ProofWorker/BigBrain.Reasoner.ProofWorker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/BigBrain.Brain/BigBrain.Brain.csproj" />
    <ProjectReference Include="../../src/BigBrain.Modules/BigBrain.Modules.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Model-free characterization reads the actual producer configuration, never a model artifact. -->
    <None Include="../../src/BigBrain.LocalReasoner.Worker/worker.cpp" Link="contract-characterization/worker.cpp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyReasonerProofWorker" AfterTargets="Build">
    <ItemGroup>
      <ProofWorkerFiles Include="../BigBrain.Reasoner.ProofWorker/bin/$(Configuration)/net10.0/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ProofWorkerFiles)" DestinationFolder="$(OutDir)reasoner-proof" />
  </Target>
</Project>

